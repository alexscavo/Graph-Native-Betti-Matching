#!/usr/bin/env bash
#SBATCH --job-name=source-test
#SBATCH --account=vnc@h100
#SBATCH --partition=gpu_p6
#SBATCH --constraint=h100
#SBATCH --qos=qos_gpu_h100-t3
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=6
#SBATCH --hint=nomultithread
#SBATCH --time=20:00:00
#SBATCH --output=experiments/spline_learning/logs/source-test-%A_%a.out
#SBATCH --error=experiments/spline_learning/logs/source-test-%A_%a.err
set -eo pipefail
export GNBM_REPO_DIR="$SLURM_SUBMIT_DIR"
export UV_CACHE_DIR="$GNBM_REPO_DIR/.cache/uv" TORCH_EXTENSIONS_DIR="$GNBM_REPO_DIR/.cache/torch-extensions"
export XDG_CACHE_HOME="$GNBM_REPO_DIR/.cache" MPLCONFIGDIR="$GNBM_REPO_DIR/.cache/matplotlib" TMPDIR=/tmp IDR_DEBUG=WARN WANDB_MODE=offline
unset JOBSCRATCH
source cluster/jean_zay/env.sh
source cluster/jean_zay/stage_spline_runtime.sh
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
mode="${1:?verify, test or collect}"
if [[ "$mode" == collect ]]; then
    python scripts/evaluate_source_transfer.py --collect test
else
    arms=(leaves_straight leaves_spline plants_straight plants_spline mri_only_straight mri_only_spline)
    arm="${arms[$SLURM_ARRAY_TASK_ID]}"
    if [[ "$mode" == verify ]]; then
        python scripts/evaluate_source_transfer.py --arm "$arm" --smoke
    elif [[ "$mode" == test ]]; then
        python scripts/evaluate_source_transfer.py --arm "$arm"
    else
        exit 2
    fi
fi
